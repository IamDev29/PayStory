# ==============================================================================
# PayStory - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' in the root directory and configure the variables.
# The Maps Platform Secrets Gradle Plugin automatically injects these into 
# Android's BuildConfig at compile time. Do NOT check the '.env' file into VCS!
# ==============================================================================

# ------------------------------------------------------------------------------
# Gemini AI Configuration (Current & Future Capabilities)
# ------------------------------------------------------------------------------
# API Key for Google Gemini. Required if you enable Gemini AI classification,
# transaction story summaries, or conversational financial insights.
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere_ReplaceMe

# ------------------------------------------------------------------------------
# Firebase Configuration (Future Cloud Sync Implementation)
# ------------------------------------------------------------------------------
# If enabling optional Firebase Cloud Firestore sync or Firebase Auth, 
# configure these values. Note: Google Services JSON setup is still required.
FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
FIREBASE_PROJECT_ID=paystory-prod-12345
FIREBASE_APP_ID=1:1234567890:android:abcdef1234567890
FIREBASE_DATABASE_URL=https://paystory-prod-default-rtdb.firebaseio.com

# ------------------------------------------------------------------------------
# Developer Environment Controls
# ------------------------------------------------------------------------------
# Set to 'true' to enable aggressive debug logging in Notification and SMS Services
DEBUG_SERVICES=false

# Seed dummy mock data on first onboarding launch (true / false)
SEED_MOCK_DATA=false
